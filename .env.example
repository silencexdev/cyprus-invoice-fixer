# === Database ===
POSTGRES_DB=cyprusinvoicefixer
POSTGRES_USER=cif_user
POSTGRES_PASSWORD=changeme_strong_password
DATABASE_URL=Host=postgres;Database=cyprusinvoicefixer;Username=cif_user;Password=changeme_strong_password

# === Redis ===
REDIS_URL=redis:6379

# === JWT ===
JWT_SECRET=changeme_jwt_secret_min_32_chars_long
JWT_ISSUER=CyprusInvoiceFixer
JWT_AUDIENCE=CyprusInvoiceFixerUsers
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30

# === AI ===
# Set provider: openai | ollama
AI_PROVIDER=openai
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY
OPENAI_MODEL=gpt-4o
# Ollama fallback (local, zero cost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# === App ===
ASPNETCORE_ENVIRONMENT=Development
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# === Stripe (optional, for paid tier) ===
STRIPE_SECRET_KEY=sk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET
STRIPE_PRICE_ID_MONTHLY=price_YOUR_ID

# === Email (optional) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=changeme
SMTP_FROM=Cyprus Invoice Fixer <noreply@example.com>
