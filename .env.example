# ============================================================
# Cyprus Invoice Fixer — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# --- Database ---
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme_strong_password

# --- JWT ---
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_ISSUER=CyprusInvoiceFixer
JWT_AUDIENCE=CyprusInvoiceFixerUsers

# --- AI Provider: openai | ollama ---
AI_PROVIDER=openai

# OpenAI (required if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Ollama (required if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# --- URLs ---
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
